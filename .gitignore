node_modules/

# build and test output
dist/
coverage/
*.tsbuildinfo
vite.config.*.timestamp-*

# logs
*.log
npm-debug.log*

# local environment files
.env
.env.*
!.env.example
*.local

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code personal settings (a shared .claude/settings.json would still be committed)
.claude/settings.local.json
